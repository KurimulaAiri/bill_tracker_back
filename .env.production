# ============================================================
# 生产环境配置（入库，由 Jenkins 部署到 /opt/node-deploy/bill_tracker_back）
#
# 加载顺序：.env（密钥，不入库） -> .env.production（本文件，可覆盖）
# 生产端口用 3001：服务器上 3000 已被 local-ops-api MCP Server 占用
# ============================================================
NODE_ENV=production

PORT=3001

UPLOAD_DIR="./uploads"
