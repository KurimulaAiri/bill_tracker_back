# ============================================================
# 本地开发环境配置（入库）
#
# 加载顺序：.env（密钥，不入库） -> .env.development（本文件，可覆盖）
# 因此这里只放与环境相关的非敏感配置，密钥一律放在 .env
# ============================================================
NODE_ENV=development

# 本地开发端口（3000 仅在本机使用，服务器上 3000 已被 local-ops-api 占用）
PORT=3000

UPLOAD_DIR="./uploads"
