# ============================================================
# 环境变量模板：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）
#
#   cp .env.example .env
#
# 说明：
#   - 密钥类配置只放 .env，不放 .env.development / .env.production
#   - 端口等与环境相关的配置放 .env.development（本地 3000）与 .env.production（生产 3001）
#   - SIGN_SECRET 必须与前端 VITE_SIGN_SECRET 保持一致
# ============================================================
DATABASE_URL="mysql://user:password@localhost:3306/bill_tracker"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
SIGN_SECRET=""
